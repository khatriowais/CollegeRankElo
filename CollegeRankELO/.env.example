# CollegeRankELO — environment configuration
# Copy this file to `.env` and edit the values. `.env` is git-ignored.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env

# --- Flask / server ---------------------------------------------------------
# Strong random string in production, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=dev-secret-change-me
FLASK_ENV=development
PORT=5000

# --- Admin panel login ------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Database ---------------------------------------------------------------
# Leave empty to use the bundled SQLite file (database/colleges.db).
# For Postgres: postgresql+psycopg2://user:pass@localhost:5432/collegerankelo
DATABASE_URL=

# --- Elo tunables -----------------------------------------------------------
ELO_K_FACTOR=32
ELO_START_RATING=1500
DRAW_THRESHOLD=2.0

# --- Comparison weights (should sum to 1.0) ---------------------------------
WEIGHT_ROI=0.40
WEIGHT_PLACEMENT=0.25
WEIGHT_PACKAGE=0.20
WEIGHT_FEES=0.10
WEIGHT_NAAC=0.05

# --- Data / ingestion -------------------------------------------------------
# Seed JSON for the curated Mumbai cohort.
DATA_FILE=
# Homepage default cohort (mumbai | india | us).
DEFAULT_COHORT=mumbai
# US College Scorecard API key (free from https://api.data.gov/signup/).
# DEMO_KEY works but is heavily rate-limited — get your own for ingestion.
SCORECARD_API_KEY=DEMO_KEY
